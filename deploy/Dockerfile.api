# FastAPI simulation & causal engine
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt "uvicorn[standard]>=0.30"
COPY engine ./engine
COPY api ./api
EXPOSE 8000
# 2 workers per container; scale containers horizontally for more capacity (Module 18)
CMD ["uvicorn", "api.index:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
